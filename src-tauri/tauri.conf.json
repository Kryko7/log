{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log",
  "version": "0.1.0",
  "identifier": "dev.logjournal.app",
  "build": {
    "beforeDevCommand": "trunk serve --config crates/journal-ui/Trunk.toml",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "trunk build --release --config crates/journal-ui/Trunk.toml",
    "frontendDist": "../crates/journal-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Log — Personal Journal",
        "width": 1340,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: https://asset.localhost data: blob:; media-src 'self' asset: https://asset.localhost blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
